# The newsletter list at Brevo that the game's signup form adds people to (see the
# player-forms skill, .agents/skills/player-forms/SKILL.md). Until BREVO_LIST_ID and
# BREVO_DOI_TEMPLATE_ID are both filled in, the game shows no signup form.
# The API key is not here: it is a secret on the Worker.
BREVO_LIST_ID=3
# The confirmation email ("double opt-in" template), and its Czech version if there is one.
BREVO_DOI_TEMPLATE_ID=1
BREVO_DOI_TEMPLATE_ID_CS=
# The contact attribute in Brevo that records the language picked in the form ("en" or
# "cs"). The privacy note in the game says the language is kept, so this must stay set.
# Create a text contact attribute with exactly this name in Brevo (Contacts > Settings >
# Contact attributes) BEFORE deploying: an unknown attribute may make signups fail.
BREVO_LANGUAGE_ATTRIBUTE=LANGUAGE
# The site key of the Turnstile widget that keeps scripts from signing addresses up.
# Its secret key is a secret on the Worker. Left empty, signups aren't checked.
TURNSTILE_SITE_KEY=0x4AAAAAAFLKXlUuevM3UXKF
