{
  "name": "streets-of-prague",
  "account_id": "7756b12931ecfb3900a31049e157d706",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "streetsofprague.com", "custom_domain": true },
    { "pattern": "streets.jonasjancarik.cz", "custom_domain": true },
    { "pattern": "streets-cf.jonasjancarik.cz", "custom_domain": true }
  ],
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
