{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streets-of-prague",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5191,
      "autoPort": true
    },
    {
      "name": "ipad-audio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        ".claude/worktrees/ipad-audio",
        "run",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "streets-of-prague-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--host",
        "0.0.0.0",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "forms",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SUBSCRIBE_URL=/api/subscribe",
        "VITE_FEEDBACK_URL=/api/feedback",
        "VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA",
        "npm",
        "run",
        "dev"
      ],
      "port": 5211,
      "autoPort": true
    }
  ]
}
