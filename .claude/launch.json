{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streets-of-prague",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5191,
      "autoPort": true
    },
    {
      "name": "ipad-audio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        ".claude/worktrees/ipad-audio",
        "run",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "streets-of-prague-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--host",
        "0.0.0.0",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "forms",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SUBSCRIBE_URL=/api/subscribe",
        "VITE_FEEDBACK_URL=/api/feedback",
        "VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA",
        "npm",
        "run",
        "dev"
      ],
      "port": 5211,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5195",
        "--bind",
        "0.0.0.0",
        "--directory",
        "site"
      ],
      "port": 5195
    },
    {
      "name": "night-audio",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=5196",
        "npm",
        "--prefix",
        ".claude/worktrees/night-audio",
        "run",
        "dev"
      ],
      "port": 5196
    },
    {
      "name": "perak",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=5231",
        "npm",
        "--prefix",
        ".claude/worktrees/perak",
        "run",
        "dev"
      ],
      "port": 5231
    },
    {
      "name": "rts-1945",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=5197",
        "npm",
        "--prefix",
        ".claude/worktrees/rts-1945",
        "run",
        "dev"
      ],
      "port": 5197
    }
  ]
}