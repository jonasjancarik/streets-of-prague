{
  "name": "streets-of-prague",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${PORT:-5191}",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "cd pipeline && uv run --group cover python -B -m unittest discover -s . -p 'test_*.py'"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "polyclip-ts": "^0.16.8",
    "proj4": "^2.22.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
